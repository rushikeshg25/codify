PORT=8080
APP_ENV=local
BLUEPRINT_DB_HOST=localhost
BLUEPRINT_DB_PORT=3306
BLUEPRINT_DB_DATABASE=codify
BLUEPRINT_DB_USERNAME=root
BLUEPRINT_DB_PASSWORD=
BLUEPRINT_DB_ROOT_PASSWORD=
# Required: the server refuses to start if this is empty.
JWT_SECRET=
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Frontend origin allowed by CORS (defaults to http://localhost:3000).
CORS_ALLOW_ORIGIN=http://localhost:3000
# Set to "true" when serving over HTTPS so the auth cookie is marked Secure.
COOKIE_SECURE=false
