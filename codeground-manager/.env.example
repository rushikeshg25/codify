# Kubernetes namespace codegrounds are created in.
K8S_NAMESPACE=default
# Path to the kubeconfig; defaults to ~/.kube/config.
KUBECONFIG=
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Required: must match CODEGROUND_TOKEN_SECRET in the API server. Per-codeground
# pod keys are derived from it, so the two derivations have to agree.
CODEGROUND_TOKEN_SECRET=
# Browser origin the in-pod agent accepts (defaults to http://localhost:3000).
CORS_ALLOW_ORIGIN=http://localhost:3000
# Database the manager reconciles against. Either a full DSN...
DB_DSN=
# ...or the same BLUEPRINT_* values the API server uses.
BLUEPRINT_DB_HOST=localhost
BLUEPRINT_DB_PORT=3306
BLUEPRINT_DB_DATABASE=codify
BLUEPRINT_DB_USERNAME=root
BLUEPRINT_DB_PASSWORD=
# How often the reconciler compares the cluster against the database.
RECONCILE_INTERVAL=2m
# How often the reaper looks for idle codegrounds, and how long a codeground
# can go without a browser heartbeat before it is stopped.
REAP_INTERVAL=5m
CODEGROUND_IDLE_TTL=30m
