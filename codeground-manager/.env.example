# Kubernetes namespace codegrounds are created in.
K8S_NAMESPACE=default
# Path to the kubeconfig; defaults to ~/.kube/config.
KUBECONFIG=
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Required: must match CODEGROUND_TOKEN_SECRET in the API server. Per-codeground
# pod keys are derived from it, so the two derivations have to agree.
CODEGROUND_TOKEN_SECRET=
# Browser origin the in-pod agent accepts (defaults to http://localhost:3000).
CORS_ALLOW_ORIGIN=http://localhost:3000
